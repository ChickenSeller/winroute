         <bool>true</bool>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QLabel" name="infoLabel2">
        <property name="text">
         <string>Note: these options only affect TCP and UDP. ICMP traffic, such as ping and tracert, cannot be routed through a proxy regardless of this setting.</string>
        </property>
        <property name="wordWrap">
