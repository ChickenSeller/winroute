    <width>620</width>
    <height>420</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>Name Resolution</string>
  </property>
  <layout class="QVBoxLayout" name="mainLayout">
   <item>
    <widget class="QGroupBox" name="dnsGroup">
     <property name="title">
      <string>WinRoute DNS settings</string>
     </property>
     <layout class="QGridLayout" name="dnsLayout">
      <item row="0" column="0">
       <widget class="QCheckBox" name="autoCheck">
        <property name="text">
         <string>Detect DNS settings automatically</string>
        </property>
       </widget>
      </item>
      <item row="0" column="1">
       <widget class="QCheckBox" name="viaProxyCheck">
        <property name="text">
         <string>Resolve hostnames through proxy</string>
        </property>
       </widget>
      </item>
      <item row="1" column="1">
       <widget class="QCheckBox" name="localFirstCheck">
        <property name="visible">
         <bool>false</bool>
        </property>
        <property name="text">
         <string>Try to resolve via local DNS service first
(may cause significant delays if local DNS is unavailable!)</string>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="noteGroup">
     <property name="title">
      <string>Note</string>
     </property>
     <layout class="QVBoxLayout" name="noteLayout">
      <item>
       <widget class="QLabel" name="noteLabel">
        <property name="text">
         <string>It is impossible to get real IP addresses through proxy.
WinRoute assigns "fake" IP addresses (198.18.*.*) that are only valid when it is running.</string>
        </property>
        <property name="wordWrap">
         <bool>true</bool>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
