      <item>
       <layout class="QHBoxLayout" name="radiosRow">
        <item>
         <widget class="QRadioButton" name="excludeRadio">
          <property name="text">
           <string>Do NOT resolve the following</string>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QRadioButton" name="onlyRadio">
          <property name="text">
           <string>Resolve ONLY the following</string>
